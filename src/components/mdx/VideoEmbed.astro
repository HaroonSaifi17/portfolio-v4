---
interface Props {
  src: string;
  title: string;
  type?: string;
}
const { src, title, type = 'video/mp4' } = Astro.props;
---

<video
  title={title}
  controls
  muted
  playsinline
  preload="metadata"
  class="w-full rounded-lg border-2 border-foreground shadow-[var(--shadow-lg)] my-8 block"
>
  <source src={src} type={type} />
  Your browser does not support the video tag.
</video>
