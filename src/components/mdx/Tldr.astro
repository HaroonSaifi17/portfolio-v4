---
interface Props {
  label?: string;
}

const { label = 'TL;DR' } = Astro.props;
---

<aside
  class="not-prose my-8 border-2 border-primary bg-accent p-6"
  aria-label={label}
>
  <div class="flex items-center gap-2 mb-3">
    <span
      class="inline-block bg-primary text-primary-foreground px-2 py-0.5 text-xs font-black uppercase tracking-[0.2em]"
    >
      {label}
    </span>
  </div>
  <div
    class="text-base md:text-lg font-bold leading-relaxed [&>p]:mb-2 [&>p:last-child]:mb-0"
  >
    <slot />
  </div>
</aside>
