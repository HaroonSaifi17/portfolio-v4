---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: items.map((item, i) => ({
    '@type': 'Question',
    name: item.q,
    position: i + 1,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
const schemaJSON = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<section class="not-prose my-10" aria-labelledby="faq-heading">
  <h2
    id="faq-heading"
    class="text-2xl md:text-3xl font-black uppercase tracking-tighter border-b-4 border-foreground pb-2 mb-6"
  >
    {title}
  </h2>
  <div class="space-y-4">
    {
      items.map((item, i) => (
        <details
          class="group border-2 border-foreground bg-card shadow-[var(--shadow-sm)]"
        >
          <summary class="cursor-pointer list-none p-4 md:p-5 font-bold uppercase tracking-tight text-base md:text-lg flex items-start justify-between gap-4 hover:text-primary transition-colors">
            <span>
              <span class="text-primary mr-2">Q{i + 1}.</span>
              {item.q}
            </span>
            <span
              class="shrink-0 text-2xl font-bold leading-none transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="px-4 md:px-5 pb-4 md:pb-5 pt-2 border-t-2 border-foreground">
            <p class="text-base font-medium leading-relaxed">{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
  <script
    is:inline
    type="application/ld+json"
    set:html={schemaJSON}
  />
</section>
