---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.svelte';
import Footer from '../../../components/Footer.svelte';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const studies = await getCollection('case-studies');

  const tagMap = new Map<string, { name: string; slug: string }>();
  const collect = (tags: string[] | undefined) => {
    for (const tag of tags ?? []) {
      const slug = tag.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { name: tag, slug });
      }
    }
  };
  for (const post of posts) collect(post.data.tags);
  for (const study of studies) collect(study.data.tags);

  return Array.from(tagMap.values()).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((p) =>
    (p.data.tags ?? []).some(
      (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-') === tag.slug,
    ),
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const studies = (await getCollection('case-studies'))
  .filter((s) =>
    (s.data.tags ?? []).some(
      (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-') === tag.slug,
    ),
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const total = posts.length + studies.length;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const pageTitle = `${tag.name} — ${total} ${total === 1 ? 'post' : 'posts'} | Mohd Haroon`;
const pageDescription = `Engineering articles and case studies tagged "${tag.name}" by Mohd Haroon. ${total} ${total === 1 ? 'piece' : 'pieces'} on ${tag.name.toLowerCase()} from a full stack developer.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/images/og-default.png"
  imageAlt={`${tag.name} — articles and case studies`}
  keywords={[tag.name.toLowerCase(), `${tag.name.toLowerCase()} tutorial`, `${tag.name.toLowerCase()} guide`]}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Blog', item: '/blog' },
    { name: 'Topics', item: '/blog/topics' },
    { name: tag.name, item: `/blog/topics/${tag.slug}` },
  ]}
>
  <Navbar client:load />

  <main class="max-w-5xl mx-auto px-6 py-20 space-y-12">
    <header class="space-y-4">
      <a
        href="/blog/topics"
        class="inline-block font-black uppercase tracking-widest text-sm border-b-2 border-foreground nav-link-hover"
        data-astro-prefetch
      >
        &larr; All Topics
      </a>
      <h1 class="page-title text-5xl md:text-7xl font-black uppercase tracking-tighter">
        #{tag.name}
      </h1>
      <p class="page-subtitle text-xl font-bold max-w-2xl border-l-2 border-primary pl-6">
        {total} {total === 1 ? 'piece' : 'pieces'} tagged "{tag.name}" — engineering
        blog posts and case studies.
      </p>
    </header>

    {posts.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-black uppercase tracking-tight border-b-2 border-foreground pb-2">
          Blog Posts
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="listing-card group flex flex-col items-start border-2 border-foreground bg-card p-6 shadow-[var(--shadow-sm)] content-card"
                data-astro-prefetch
                transition:name={`blog-card-${post.id}`}
              >
                <span
                  class="font-black uppercase tracking-widest bg-foreground text-background px-2 py-1 text-xs"
                  transition:name={`blog-date-${post.id}`}
                >
                  {formatDate(post.data.pubDate)}
                </span>
                <h3 class="text-xl font-bold uppercase tracking-tight mt-4 mb-2">
                  {post.data.title}
                </h3>
                <p class="text-base font-medium text-muted-foreground leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              </a>
            ))
          }
        </div>
      </section>
    )}

    {studies.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-black uppercase tracking-tight border-b-2 border-foreground pb-2">
          Case Studies
        </h2>
        <div class="grid grid-cols-1 gap-6">
          {
            studies.map((study) => (
              <a
                href={`/case-studies/${study.id}`}
                class="group block border-2 border-foreground bg-card content-card"
                data-astro-prefetch
                transition:name={`case-study-card-${study.id}`}
              >
                <div class="p-6 space-y-3">
                  <div class="flex flex-wrap items-center gap-3">
                    <span
                      class="font-black uppercase tracking-widest bg-foreground text-background px-2 py-1 text-xs"
                      transition:name={`case-study-date-${study.id}`}
                    >
                      {formatDate(study.data.pubDate)}
                    </span>
                    {study.data.category && (
                      <span class="font-bold uppercase tracking-wider text-muted-foreground text-xs">
                        {study.data.category}
                      </span>
                    )}
                  </div>
                  <h3 class="text-2xl font-bold uppercase tracking-tight">
                    {study.data.title}
                  </h3>
                  <p class="text-base font-medium text-muted-foreground leading-relaxed">
                    {study.data.description}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    )}

    {total === 0 && (
      <p class="text-xl font-bold text-muted-foreground">
        No content found for this topic.
      </p>
    )}
  </main>

  <Footer />
</Layout>
